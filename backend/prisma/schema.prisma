generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  password     String
  calculations Calculation[] 
}

model Calculation {
  id             String   @id @default(uuid())
  value          Float    
  operator       String?  
  operand        Float?   
  
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])

  parentId       String?
  parent         Calculation?  @relation("ParentChild", fields: [parentId], references: [id])
  replies        Calculation[] @relation("ParentChild")

  createdAt      DateTime @default(now())
}